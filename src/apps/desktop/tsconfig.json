{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": { "$shared/*": ["./src/shared/*"], "$shared": ["./src/shared"] }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "*.ts"
  ]
}
