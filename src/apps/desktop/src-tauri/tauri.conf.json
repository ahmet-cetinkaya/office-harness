{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "office-harness",
  "version": "0.1.0",
  "identifier": "dev.office-harness.desktop",
  "build": {
    "beforeDevCommand": "bun scripts/prepare-sidecar.ts && bun run dev",
    "beforeBuildCommand": "bun scripts/prepare-sidecar.ts --release && bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "office-harness", "width": 1100, "height": 720 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/office-harnessd"]
  }
}
